# Mimi Lab configuration — copy to .env and fill in. Never commit .env.

# jimaku.cc API key (account settings → API). Required for subtitle fetching.
JIMAKU_TOKEN=

# MyAnimeList — register a 'web' app at https://myanimelist.net/apiconfig/create
# with redirect URL http://localhost:8000/api/mal/callback
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=

# English secondary subtitles — a native-language reference track shown alongside
# the Japanese study track (you toggle "secondary subtitles" in Migaku's own
# settings; English is never tokenized — Japanese stays the study language).
#  ENGLISH_SUBS_ENABLED — master switch (true/false).
#  ENGLISH_SOURCE — "human" (default: embedded English softsub from the release,
#    else the official track via AnimeTosho) or "llm" (machine-translate the
#    Japanese with Claude).
ENGLISH_SUBS_ENABLED=true
ENGLISH_SOURCE=human
# TRANSLATION_MODEL — Claude model used when ENGLISH_SOURCE=llm.
TRANSLATION_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY — required for LLM translation (and optional smart matching).
ANTHROPIC_API_KEY=

# Connector (runs on the machine where you watch — Chrome + Migaku). The server
# never plays media itself; it streams the bytes and relays a one-click Play to a
# user-side Connector over a WebSocket. See connector/README.md.
#
# MIMI_LAB_TOKEN — shared secret the Connector presents (WebSocket auth + the
#   known-words/comprehension upload endpoints). Per-play media URLs carry a
#   short-lived token derived from it. Blank = loopback/dev (auth disabled); set a
#   long random value (e.g. `python -c "import secrets;print(secrets.token_hex(32))"`)
#   before exposing the server beyond localhost.
MIMI_LAB_TOKEN=
# SERVER_PUBLIC_URL — base URL the Connector (and Migaku, fetching media) reaches
#   this server at. Blank = derive from the request (same-LAN). For a remote
#   Connector, use a trusted TLS endpoint and set the https URL here.
SERVER_PUBLIC_URL=
MIGAKU_EXT_ID=dmeppfcidcpcocleneopiblmpnbokhep

# Native scorer (dormant/experimental). If MIGAKU_NATIVE_SCORER is explicitly
# enabled, this must be a user-provided path to its gzipped SQLite database.
MIGAKU_SRS_GZ=

# Transmission (headless torrent daemon)
TRANSMISSION_HOST=127.0.0.1
TRANSMISSION_PORT=9091

# Paths (defaults are fine)
MIMI_LAB_DB=./data/mimi_lab.db
LIBRARY_DIR=./Library
