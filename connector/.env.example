# Mimi Lab Connector — runs on the machine where you watch (Chrome + Migaku).
# Copy to .env (or just export these). Point it at your Lab server + shared secret.

# The Lab server's base URL (where the Connector reaches it). Plain http on your
# LAN is fine — the Connector relays media over loopback so Migaku can fetch it,
# so NO HTTPS/certs are needed. Prefer a configured DNS or mDNS name over a raw
# LAN IP because DHCP leases can move. Example:
#   http://lab-server.example:8000
SERVER_URL=http://127.0.0.1:8000

# Loopback media-proxy port — Migaku fetches http://127.0.0.1:<port>. Change if taken.
# CONNECTOR_PROXY_PORT=8787

# Shared secret — must equal MIMI_LAB_TOKEN in the SERVER's .env.
MIMI_LAB_TOKEN=

# CDP endpoint of your dedicated Chrome (loopback only; never exposed).
CDP_URL=http://127.0.0.1:9222

# Chrome the Connector manages. A dedicated --user-data-dir keeps Migaku logged in
# and satisfies Chrome ≥136's "no debug port on the default profile" rule.
# CHROME_BIN=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# MIGAKU_USER_DATA_DIR=/path/to/dedicated/chrome-profile
# CONNECTOR_LAUNCH_CHROME=1     # set 0 to never auto-launch Chrome (you start it)
# CONNECTOR_DEVICE_ID=device-a  # optional stable routing override
# CONNECTOR_DEVICE_NAME=Device A  # optional display label

# Protocol-only smoke test: speak the WebSocket protocol + ack play commands
# WITHOUT touching Chrome (no playwright/sql.js needed). Handy for first-run wiring.
# CONNECTOR_DRY_RUN=1
